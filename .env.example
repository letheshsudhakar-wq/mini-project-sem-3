# Supabase Configuration
# Add your real project credentials from Project Settings > API.
# These values are required for real Google OAuth sign-in and Supabase client connection.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional app URL override for OAuth redirects.
# Use your deployed production URL in production and http://localhost:5173 during local development.
VITE_SITE_URL=http://localhost:5173
# VITE_APP_URL=https://your-production-domain.com
