# Supabase Configuration
# Add your real project credentials from Project Settings > API.
# These values are required for real Google OAuth sign-in and Supabase client connection.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Use the anon JWT or a publishable key here. Never use a secret/service-role key in the browser.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional app origin override for OAuth redirects; if omitted, the current browser origin is used.
# VITE_SITE_URL=https://your-production-domain.example
